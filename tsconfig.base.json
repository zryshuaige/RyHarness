{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@ryagent/cordis": ["./vendor/cordis/src/index.ts"],
      "@ryagent/cosmokit": ["./vendor/cosmokit/src/index.ts"],
      "@ryagent/schemastery": ["./vendor/schemastery/src/index.ts"],
      "@ryagent/typert-protocol": ["./packages/typert/protocol/src/index.ts"],
      "@ryagent/typert-protocol/*": ["./packages/typert/protocol/src/*"],
      "@ryagent/brand": ["./packages/util/brand/src/index.ts"],
      "@ryagent/util-values": ["./packages/util/values/src/index.ts"],
      "@ryagent/util-crypto": ["./packages/util/crypto/src/index.ts"],
      "@ryagent/timeout": ["./packages/util/timeout/src/index.ts"],
      "@ryagent/invariants": ["./packages/runtime-diagnostics/invariants/src/index.ts"],
      "@ryagent/attachment": ["./packages/attachment/types/src/index.ts"],
      "@ryagent/llm": ["./packages/llm/llm/src/index.ts"],
      "@ryagent/llm/*": ["./packages/llm/llm/src/*"],
      "@ryagent/llm-openai": ["./packages/llm/openai/src/index.ts"],
      "@ryagent/agent": ["./packages/agent/src/index.ts"],
      "@ryagent/group": ["./packages/group/src/index.ts"],
      "@ryagent/tools": ["./packages/tools/src/index.ts"],
      "@ryagent/session": ["./packages/session/src/index.ts"],
      "@ryagent/server": ["./apps/server/src/index.ts"]
    }
  }
}
