    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@ryharness/typert-gateway": "workspace:*",
    "@ryharness/typert-protocol": "workspace:*"
  }
}
