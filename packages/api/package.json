{
  "name": "@ryharness/api",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "description": "Remote 层：宿主把本地对象按类型图暴露出去，客户端连上就能按类型调",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
