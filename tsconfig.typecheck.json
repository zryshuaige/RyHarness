{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@ryharness/cordis": ["./vendor/cordis/lib/index.d.ts"],
      "@ryharness/cosmokit": ["./vendor/cosmokit/lib/index.d.ts"],
      "@ryharness/schemastery": ["./vendor/schemastery/lib/index.d.ts"],
      "@ryharness/typert-protocol": ["./packages/typert/protocol/src/index.ts"],
      "@ryharness/typert-protocol/*": ["./packages/typert/protocol/src/*"],
      "@ryharness/brand": ["./packages/util/brand/src/index.ts"],
      "@ryharness/util-values": ["./packages/util/values/src/index.ts"],
      "@ryharness/util-crypto": ["./packages/util/crypto/src/index.ts"],
      "@ryharness/timeout": ["./packages/util/timeout/src/index.ts"],
      "@ryharness/util-llm-json": ["./packages/util/llm-json/src/index.ts"],
      "@ryharness/attachment": ["./packages/attachment/types/src/index.ts"],
      "@ryharness/llm": ["./packages/llm/llm/src/index.ts"],
      "@ryharness/llm/*": ["./packages/llm/llm/src/*"],
      "@ryharness/llm-openai": ["./packages/llm/openai/src/index.ts"],
      "@ryharness/agent": ["./packages/agent/src/index.ts"],
      "@ryharness/group": ["./packages/group/src/index.ts"],
      "@ryharness/tools": ["./packages/tools/src/index.ts"],
      "@ryharness/session": ["./packages/session/src/index.ts"],
      "@ryharness/server": ["./apps/server/src/index.ts"],
      "@ryharness/voice": ["./packages/voice/src/index.ts"],
      "@ryharness/memory": ["./packages/memory/src/index.ts"],
      "@ryharness/evolve": ["./packages/evolve/src/index.ts"],
      "@ryharness/mcp": ["./packages/mcp/src/index.ts"],
      "@ryharness/subagent": ["./packages/subagent/src/index.ts"],
      "@ryharness/context": ["./packages/context/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "scripts", "vitest.config.ts"],
  "exclude": ["**/lib", "**/node_modules"]
}
