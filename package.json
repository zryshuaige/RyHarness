{
  "name": "ryagent-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RyAgent：单机多 Agent 即时通讯桌面应用（Electron + React + cordis 内核）",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --filter \"./vendor/**\" run build && tsc -p tsconfig.typecheck.json",
    "lint": "biome check .",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "version:check": "node scripts/bump.mjs --check",
    "version:bump": "node scripts/bump.mjs --set",
    "smoke:siliconflow": "tsx scripts/smoke-siliconflow.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "demo:group": "tsx scripts/demo-group.ts",
    "demo:server": "tsx scripts/demo-server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "ws": "^8.18.3"
  }
}
