{
  "name": "ryharness-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RyHarness：单机多 Agent 即时通讯桌面应用（Electron + React + cordis 内核）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zryshuaige/RyHarness.git"
  },
  "homepage": "https://github.com/zryshuaige/RyHarness#readme",
  "bugs": {
    "url": "https://github.com/zryshuaige/RyHarness/issues"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --filter \"./vendor/**\" run build && tsc -p tsconfig.typecheck.json",
    "lint": "biome check .",
    "verify": "node scripts/verify-no-unknown-casts.mjs && node scripts/verify-package-deps.mjs && node scripts/verify-duplication.mjs && node scripts/verify-biome-budget.mjs && node scripts/verify-notice.mjs",
    "verify:notice": "node scripts/verify-notice.mjs",
    "verify:casts": "node scripts/verify-no-unknown-casts.mjs",
    "verify:deps": "node scripts/verify-package-deps.mjs",
    "verify:dup": "node scripts/verify-duplication.mjs",
    "verify:biome": "node scripts/verify-biome-budget.mjs",
    "verify:biome:freeze": "node scripts/verify-biome-budget.mjs --freeze",
    "bench": "tsx scripts/bench.ts",
    "perf": "vitest run --config vitest.perf.config.ts",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "version:check": "node scripts/bump.mjs --check",
    "version:bump": "node scripts/bump.mjs --set",
    "smoke:siliconflow": "tsx scripts/smoke-siliconflow.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "demo:group": "tsx scripts/demo-group.ts",
    "demo:server": "tsx scripts/demo-server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsdown": "^0.23.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "ws": "^8.18.3"
  }
}
