{
  "name": "@ryharness/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "RyHarness 桌面应用：单机多 Agent 即时通讯（Electron + React）",
  "author": "RyHarness contributors",
  "main": "./main/main.mjs",
  "scripts": {
    "build:main": "tsdown --config tsdown.config.mjs",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "capture": "node scripts/capture.mjs",
    "gen:icon": "node scripts/gen-icon.mjs",
    "package": "pnpm run build && electron-builder --win",
    "package:dir": "pnpm run build && electron-builder --win --dir",
    "package:release": "node scripts/package-release.mjs",
    "smoke:release": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "smoke:portable": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-portable.ps1"
  },
  "dependencies": {
    "@ryharness/server": "workspace:*"
  },
  "devDependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@ryharness/session": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.2",
    "electron-builder": "^26.17.0",
    "jsdom": "^26.0.0",
    "lucide-static": "^1.55.0",
    "marked": "^18.1.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.ryharness.desktop",
    "productName": "RyHarness",
    "copyright": "Copyright (c) 2026 RyHarness contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "assets/**/*",
      "!assets/animals-raw/**",
      "package.json",
      "!**/*.map",
      "!node_modules/@ryharness/**/src{,/**/*}",
      "!node_modules/@ryharness/**/tsconfig.json",
      "!node_modules/@ryharness/**/tsdown.config.mjs"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE.md",
        "to": "NOTICE.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "../../LICENSE"
    },
    "portable": {
      "artifactName": "RyHarness-portable.exe"
    }
  }
}
