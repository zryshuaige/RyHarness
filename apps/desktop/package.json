{
  "name": "@ryagent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./main/main.mjs",
  "scripts": {
    "build:main": "tsdown --config tsdown.config.mjs",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "capture": "node scripts/capture.mjs",
    "gen:icon": "node scripts/gen-icon.mjs",
    "package": "pnpm run build && electron-builder --win",
    "package:dir": "pnpm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@ryagent/server": "workspace:*",
    "marked": "^18.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "37.10.2",
    "electron-builder": "^26.17.0",
    "jsdom": "^26.0.0",
    "lucide-static": "^1.55.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.ryagent.desktop",
    "productName": "RyAgent",
    "copyright": "Copyright (c) 2026 RyAgent contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE.md",
        "to": "NOTICE.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "../../LICENSE"
    }
  }
}
