{
  "name": "@ryagent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./main/main.mjs",
  "scripts": {
    "build:main": "tsdown --config tsdown.config.mjs",
    "build:renderer": "vite build --config renderer/vite.config.ts && node scripts/inline-dist.mjs",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@ryagent/server": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "37.10.2",
    "jsdom": "^26.0.0",
    "vite": "^6.0.0"
  }
}
